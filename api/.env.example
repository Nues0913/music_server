# Run npm commands from api/. Prisma resolves file paths relative to prisma/schema.prisma.
DATABASE_URL=file:../../data/db/songs.db?connection_limit=1&socket_timeout=5
API_TOKEN=replace-with-the-same-random-token-as-root-env
ADMIN_TOKEN=replace-with-the-admin-token-from-root-env
AUDIO_DIRECTORY=../data/audio
IMPORT_DIRECTORY=../data/inbox
HOST=127.0.0.1
LOG_LEVEL=info
MAX_AUDIO_BYTES=268435456
MIN_FREE_BYTES=536870912
LIBRARY_QUOTA_BYTES=10737418240


# Dedicated trusted-Bot credential for per-user playlist APIs; setup.sh generates it.
PLAYLIST_BOT_TOKEN=
