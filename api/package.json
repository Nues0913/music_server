{
  "name": "remote-music-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rm -rf dist && tsc",
    "start": "node dist/server.js",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:smoke": "node test/smoke.mjs",
    "test:browser": "node test/browser-upload.mjs",
    "test:upload": "node test/upload-smoke.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "import": "tsx src/cli.ts import",
    "cli": "tsx src/cli.ts",
    "test:fixture": "node test/make-fixture.mjs",
    "test:memory": "bash test/memory.sh",
    "check:architecture": "node scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test --test-concurrency=1 test/admin-controller.test.ts test/admin-browser.test.ts test/migration-sql.test.ts test/playlist-model.test.ts test/http-contracts.test.ts test/shutdown.test.ts",
    "test:nginx-contracts": "npm run build && node test/nginx-contracts.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "9.4.0",
    "@prisma/client": "6.19.3",
    "dotenv": "17.2.1",
    "fastify": "5.12.5",
    "music-metadata": "11.16.1",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "playwright-core": "1.58.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
